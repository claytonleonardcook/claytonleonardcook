---
import ResumeSection from "../components/ResumeSection.astro";
import ResumeLayout from "../layouts/Resume.astro";
---

<ResumeLayout>
  <header class="flex flex-col gap-1">
    <div class="flex flex-row items-end">
      <h1 class="font-bold">Clayton Leonard Cook</h1>
    </div>
    <div class="flex flex-row gap-2">
      <!-- <div class="flex flex-row gap-1 items-center">
            <a class="hover:underline" href="tel:">
                +1 (000) 000-000
            </a>
        </div>
        | -->
      <div class="flex flex-row gap-1 items-center">
        <a class="hover:underline" href="mailto:work@claytonleonardcook.com">
          work@claytonleonardcook.com
        </a>
      </div>
      |
      <div class="flex flex-row gap-1 items-center">
        <a class="hover:underline" href="https://claytonleonardcook.com">
          claytonleonardcook.com
        </a>
      </div>
      |
      <div class="flex flex-row gap-1 items-center">
        <a
          class="hover:underline"
          href="https://www.linkedin.com/in/claytonleonardcook"
        >
          @claytonleonardcook
        </a>
      </div>
    </div>
    <section>
      <h2 class="font-bold">Summary</h2>
      <hr />
      <p>
        Senior Software Engineer with over 5 years of experience in software
        architecture, system design and API development across enterprise web
        and mobile platforms. Specialized in building scalable frontend
        architectures using React, Next.js and TypeScript, with proven technical
        leadership in establishing coding standards, expanding test coverage
        from 10% to 80% and scaling applications for over 50,000 active users.
      </p>
    </section>
  </header>
  <br />
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Work Experience</h2>
    <hr />
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Kforce | Software Engineer III — Redmond, Washington
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2025-07/2026-04">July 2025 – Apr 2026</time>
        </span>
      </div>
      <p>
        Architected and owned modular frontend portals and GraphQL resolvers,
        increasing automated test coverage from 10% to 80% and improving
        production reliability. Led technical standards and documentation across
        distributed teams, accelerating developer onboarding.
      </p>
    </ResumeSection>
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Cellar Door | Software Engineer — Remote
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2022-05/2025-07">May 2022 – July 2025</time>
        </span>
      </div>
      <p>
        Engaged in system design, software architecture and technical
        documentation for headless e-commerce platforms servicing 50,000+ active
        users and authorable, statically generated sites. Partnered closely with
        design and backend teams to refactor legacy code, resolve critical
        algorithm bottlenecks and integrate headless CMS and e-commerce
        solutions.
      </p>
    </ResumeSection>
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Campbell Ewald | Software Engineer — Remote
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2022-12/2024-02">Dec 2022 – Feb 2024</time>
        </span>
      </div>
      <p>
        Engineered CMS-driven Next.js frontend applications, crafting custom
        React component libraries aligned with strict design mockups. Navigated
        complex security and authentication layers alongside enterprise
        infrastructure teams while delivering error-resilient data query
        helpers.
      </p>
    </ResumeSection>
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Onflo | Software Engineer — Remote
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2018-06/2021-02">June 2018 – Feb 2021</time>
        </span>
      </div>
      <p>
        Designed and implemented brand-aligned marketing interfaces and
        interactive admin dashboard features using React, HTML5 and CSS3.
        Focused on building responsive front-end experiences that drove user
        engagement and streamlined data management.
      </p>
    </ResumeSection>
  </section>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Projects</h2>
    <hr />
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Amazon Leo — Third-Party Technician Web Portal
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2025-07/2026-04">July 2025 – Apr 2026</time>
        </span>
      </div>
      <p>
        Within a six person team, architected core features for a third-party
        technician portal during a major redesign, establishing code standards
        and expanding test coverage from 10% to 80% to ensure production
        reliability..
      </p>
    </section>
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Garanimals & Easy-Peasy — CMS-Authorable, E-commerce Website
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="">Jan 2024 – July 2025</time>
        </span>
      </div>
      <p>
        Within a five person team, laid the foundation for a headless, Next.js,
        e-commerce platform to overhaul legacy client architectures, enabling
        seamless content management and scaling service for 50,000+ active
        users.
      </p>
    </section>
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Everbank — CMS-Authorable, Banking Website
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="">Dec 2022 – Feb 2024</time>
        </span>
      </div>
      <p>
        Within a six person team, developed a statically generated site that
        used promise-based queries to retrieve data from ContentStack CMS and
        collaborated with internal teams to navigate client's multiple security
        layers.
      </p>
    </section>
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Beef Jerky Experience — E-commerce, Mobile Application
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="">Oct 2022 – Jan 2023</time>
        </span>
      </div>
      <p>
        As a sole developer, built a cross-platform, React Native application
        from scratch, expanding brand presence to mobile and streamlining the
        customer checkout experience.
      </p>
    </section>
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Factimize — Pattern Viewer Web Application
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="">Aug 2022 – Oct 2023</time>
        </span>
      </div>
      <p>
        Within a two person team, diagnosed and resolved severe algorithm
        bottlenecks that inhibited preformance within a complex timeline
        visualization tool, refactoring dataset rendering to ensure fluid user
        interaction with massive data points.
      </p>
    </section>
    <section>
      <div class="flex flex-row items-center">
        <h4 class="flex flex-row items-center gap-2 grow">
          Peloton & Precor — CMS-Authorable, Product Website
        </h4>
        <span class="break-keep whitespace-nowrap">
          <time datetime="">May 2022 – Nov 2023</time>
        </span>
      </div>
      <p>
        Within a five person team, implemented CMS-authorable marketing pages in
        an established repository, integrating Google Maps APIs with dynamic CMS
        data to power an interactive international office locator that serviced
        90+ global locations.
      </p>
    </section>
  </section>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Skills</h2>
    <hr />
    <ResumeSection>
      <p>
        <b>Languages:&nbsp;</b>
        JavaScript, TypeScript, HTML5, CSS3, SASS, GraphQL, Bash
      </p>
      <p>
        <b>Frameworks & Runtimes:&nbsp;</b>
        Next.js, React, Deno, Node.js, Cypress, Vite, Jest, Expo, React Native, Docker
      </p>
      <p>
        <b>Databases & Content Management Systems:&nbsp;</b>
        SQLite, PostgreSQL, Drupal, Contentful, Contentstack
      </p>
      <p>
        <b>Tools:&nbsp;</b>
        Agile/SCRUM, Jira, ClickUp, Slack, Chime, Google Meet, Figma, CI/CD, Git,
        Storybook, AWS, Claude, Linux, VSCode
      </p>
    </ResumeSection>
  </section>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Education</h2>
    <hr />
    <ResumeSection>
      <div class="flex flex-row items-center gap-2">
        <h3 class="grow">
          <span class="break-keep whitespace-nowrap"
            >Saginaw Valley State University
          </span>
          —
          <span class="break-keep whitespace-nowrap">
            Bachelor of Science in Computer Science</span
          >
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2019-09/2025-05">Sept 2019 – May 2025</time>
        </span>
      </div>
      <p>
        Graduated with a 3.5 GPA and served as the President of Cardinal
        Robotics Club, Vice President of the Google Developer Student Club and
        volunteer for high school coding competitions through the ACM chapter.
      </p>
    </ResumeSection>
  </section>
</ResumeLayout>
