---
import ResumeSection from "../components/ResumeSection.astro";
import ResumeLayout from "../layouts/Resume.astro";
---

<ResumeLayout>
  <header class="flex flex-col gap-1">
    <div class="flex flex-row items-end">
      <h1 class="font-bold">Clayton Cook</h1>
    </div>
    <div class="flex flex-row gap-2">
      <div class="flex flex-row gap-1 items-center">
        <a class="hover:underline" href="mailto:work@claytonleonardcook.com">
          work@claytonleonardcook.com
        </a>
      </div>
      |
      <div class="flex flex-row gap-1 items-center">
        <a
          class="hover:underline"
          href="https://linkedin.com/in/claytonleonardcook"
        >
          linkedin.com/in/claytonleonardcook
        </a>
      </div>
    </div>
    <section>
      <h2 class="font-bold">Summary</h2>
      <hr />
      <p>
        Senior Software Engineer with 4+ years of building React-based web
        applications with complex design systems. Seeking remote or hybrid
        opportunities focused on complex system design and product growth.
      </p>
    </section>
  </header>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Skills</h2>
    <hr />
    <ResumeSection>
      <p>
        <b>Languages:&nbsp;</b>
        JavaScript, TypeScript, HTML5, CSS3, SASS, GraphQL, Bash
      </p>
      <p>
        <b>Frameworks & Runtimes:&nbsp;</b>
        Next.js, React, Deno, Node.js, Cypress, Vite, Jest, Docker
      </p>
      <p>
        <b>Databases & Content Management Systems:&nbsp;</b>
        Drupal, Contentful, Contentstack, SQLite, PostgreSQL
      </p>
      <p>
        <b>Tools:&nbsp;</b>
        Agile/SCRUM, Figma, CI/CD, Git, Storybook, AWS, Claude, Linux
      </p>
    </ResumeSection>
  </section>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Work Experience</h2>
    <hr />
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Kforce | Software Engineer III (Contract) — Redmond, Washington
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2025-07/2026-04">July 2025 – Apr 2026</time>
        </span>
      </div>
      <p>
        Contracted to Amazon to engineer core internal tooling and
        technician-facing web applications across distributed systems.
      </p>
      <ul class="list-disc ml-6">
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Amazon Leo — Third-Party Technician Web Portal
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="2025-07/2026-04">July 2025 – Apr 2026</time>
              </span>
            </div>
            <p>
              Overhauled a React-based, third-party technician portal during a
              major redesign, integrating with multiple microservices,
              establishing code standards and expanding test coverage from 10%
              to 80%.
            </p>
          </section>
        </li>
      </ul>
    </ResumeSection>
    <ResumeSection>
      <div class="flex flex-row items-center">
        <h3 class="flex flex-row items-center gap-2 grow">
          Cellar Door | Software Engineer (Contract) — Remote
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2022-05/2025-07">May 2022 – July 2025</time>
        </span>
      </div>
      <p>
        Architected frontends with headless CMS integrations across high-volume
        e-commerce and enterprise client accounts.
      </p>
      <ul class="list-disc ml-6">
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Garanimals & Easy-Peasy — CMS-Authorable, E-commerce Website
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="">Jan 2024 – July 2025</time>
              </span>
            </div>
            <p>
              Created the foundation for a headless, Next.js, e-commerce
              platform to overhaul legacy client architectures, enabling
              seamless content management and scaling service for 50,000+ active
              users.
            </p>
          </section>
        </li>
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Everbank — CMS-Authorable, Banking Website
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="">Dec 2022 – Feb 2024</time>
              </span>
            </div>
            <p>
              Delivered a statically generated Next.js site that used
              promise-based queries to retrieve data from Contentstack CMS and
              collaborated with internal teams to navigate client's multiple
              security layers.
            </p>
          </section>
        </li>
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Beef Jerky Experience — E-commerce, Mobile Application
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="">Oct 2022 – Jan 2023</time>
              </span>
            </div>
            <p>
              Built a cross-platform, React Native application from scratch,
              expanding brand presence to mobile and streamlining the customer
              checkout experience.
            </p>
          </section>
        </li>
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Factimize — Pattern Viewer Web Application
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="">Aug 2022 – Oct 2023</time>
              </span>
            </div>
            <p>
              Resolved severe algorithm bottlenecks in a React application that
              inhibited performance within a complex timeline visualization
              tool, refactoring dataset rendering to ensure fluid user
              interaction with massive data points.
            </p>
          </section>
        </li>
        <li>
          <section>
            <div class="flex flex-row items-center">
              <strong class="flex flex-row items-center gap-2 grow">
                Peloton & Precor — CMS-Authorable, Product Website
              </strong>
              <span class="break-keep whitespace-nowrap">
                <time datetime="">May 2022 – Nov 2023</time>
              </span>
            </div>
            <p>
              Implemented CMS-authorable marketing pages in an established
              Next.js repository, integrating Google Maps with dynamic CMS data
              to power an interactive international office locator that serviced
              90+ global locations.
            </p>
          </section>
        </li>
      </ul>
    </ResumeSection>
  </section>
  <section class="flex flex-col gap-1">
    <h2 class="font-bold">Education</h2>
    <hr />
    <ResumeSection>
      <div class="flex flex-row items-center gap-2">
        <h3 class="grow">
          <span class="break-keep whitespace-nowrap"
            >Saginaw Valley State University
          </span>
          &nbsp;—&nbsp;
          <span class="break-keep whitespace-nowrap">
            Bachelor of Science in Computer Science</span
          >
        </h3>
        <span class="break-keep whitespace-nowrap">
          <time datetime="2019-09/2025-05">Sept 2019 – May 2025</time>
        </span>
      </div>
      <p>
        Graduating with a 3.5 GPA, served as the President of Cardinal Robotics
        Club, Vice President of the Google Developer Student Club and
        volunteered through the ACM chapter for high school coding competitions.
      </p>
    </ResumeSection>
  </section>
</ResumeLayout>
